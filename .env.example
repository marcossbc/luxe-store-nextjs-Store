# Which sources to load: comma separated -> static,shopify,cj
PRODUCT_SOURCES=shopify,cj

# Shopify Storefront API (Shopify admin > Settings > Apps > Develop apps)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=

# CJ Dropshipping API (CJ account > Authorization > API key)
CJ_API_KEY=
# Optional: default markup applied to CJ cost prices (1.8 = +80%)
CJ_PRICE_MARKUP=1.8
ORDER_WEBHOOK_SECRET=change-me

# Luxe UI
NEXT_PUBLIC_STORE_CURRENCY=USD
# Optional film for the "Discover Craftsmanship" modal (put the file in /public/videos)
NEXT_PUBLIC_EXPLAINER_VIDEO_URL=
