# ---------------------------------------------------------------------------
# Copy to .env.local (never commit real values; .gitignore already blocks .env*).
# All variables below are SERVER-ONLY. Never prefix a secret with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Which product sources to load: comma separated -> static,shopify,cj
PRODUCT_SOURCES=shopify,cj

# Shopify Storefront API. Domain must be <shop>.myshopify.com (anything else is ignored).
# Least privilege: grant the Storefront token ONLY unauthenticated_read_product_listings
# and unauthenticated_write_checkouts. Do not use Admin API tokens here.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
# Only if Shopify returns checkout links on a custom domain: comma-separated allow-list
SHOPIFY_CHECKOUT_HOSTS=

# CJ Dropshipping API key (CJ account > Authorization). Server-side only.
CJ_API_KEY=
# Markup applied to CJ cost prices, allowed range 1-10 (default 1.8)
CJ_PRICE_MARKUP=1.8

# Shared secret for the server-to-server order endpoint /api/orders/cj.
# MUST be >= 24 random characters or the endpoint stays disabled. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_WEBHOOK_SECRET=

# Extra browser origins allowed to call write APIs (CSRF allow-list), comma separated. Usually empty.
ALLOWED_ORIGINS=

# Public, non-secret UI settings
NEXT_PUBLIC_STORE_CURRENCY=USD
# Optional film for the "Discover Craftsmanship" modal (same-site path or https URL)
NEXT_PUBLIC_EXPLAINER_VIDEO_URL=

# Optional header details. Nothing is shown unless set (and valid): no placeholder phone numbers or dead links.
NEXT_PUBLIC_SUPPORT_PHONE=
# https URLs only
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# Shown on the /contact page. Leave empty to hide a row (phone uses NEXT_PUBLIC_SUPPORT_PHONE above).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_HOURS=
